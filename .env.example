# Root .env only. Never commit populated values or use NEXT_PUBLIC_ for secrets.
# Console authorization. Generate a random value of at least 32 characters.
DEMO_ACCESS_TOKEN=
# Durable Postgres for deployment. pnpm db:local configures a local development DB.
DATABASE_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
INTERCEPTA_API_KEY=
SEPOLIA_RPC_URL=
# Optional comma-separated Sepolia read RPCs. Defaults to the public ethpandaops endpoint.
SEPOLIA_RPC_FALLBACK_URLS=
BASE_SEPOLIA_RPC_URL=
# One or more exact, registered service names, comma-separated.
SERVICE_ENS_NAME=
# HTTPS origins only, comma-separated. Outbound merchant requests are restricted here.
MERCHANT_ALLOWED_ORIGINS=https://ens402.vercel.app
MERCHANT_RESOURCE_URL=https://ens402.vercel.app/api/merchant/search
# HTTP 402 recipient. For schema v3 this must match the current service-name holder.
# Demo fixtures pay this Base Sepolia address; it must match the registering service-name owner.
MERCHANT_PAY_TO=
MERCHANT_PRICE_UNITS=10000
FACILITATOR_URL=https://x402.org/facilitator
# Server ceilings in USDC atomic units (6 decimals).
DEMO_MAX_PAYMENT_UNITS=1000000
DEMO_MAX_DAILY_UNITS=10000000
# Setup CLI only. These are public addresses, never private keys.
ENS_OWNER_ADDRESS=
ENS_OPERATOR_ADDRESS=
# Service payment-record writer, distinct from Ops. May be the service Admin.
ENS_TREASURY_ADDRESS=
# Optional archive RPC override for disposable fork tests.
ENS_FORK_RPC_URL=
# Optional Base Sepolia block for a reproducible payment fork.
BASE_FORK_BLOCK=

# Optional public subdomain registration (current ENSv2 Sepolia)
ENS_PARENT_NAME=
SERVICE_REGISTRAR_ADDRESS=

# Public metadata for the unsigned service setup planner. Picture is optional.
SERVICE_DESCRIPTION=
SERVICE_PICTURE_URL=
# Optional fixed-price x402 subname purchase. Dedicated funded testnet worker only.
ENS_REGISTRATION_RESOURCE_URL=https://ens402.vercel.app/api/merchant/register
ENS_PURCHASE_REGISTRY=
# Absolute Unix expiry for purchased names, within the active parent lifetime.
ENS_PURCHASE_EXPIRY=
# Server-only Sepolia key with ROLE_REGISTRAR on ENS_PURCHASE_REGISTRY. Never the parent Admin key.
ENS_REGISTRATION_PRIVATE_KEY=

# Optional Curvegrid MultiBaas read-only ENSv2 event monitoring on Ethereum Sepolia.
# Create a Sepolia deployment, link the native Registry and Resolver, and enable event sync.
# Keep the API key server-side. Indexed events are historical observations only.
MULTIBAAS_BASE_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_ENS_REGISTRY_ADDRESS=
MULTIBAAS_ENS_RESOLVER_ADDRESS=
# Relative blocks, e.g. -80, respect the deployment plan's backfill limit.
MULTIBAAS_START_BLOCK=-80

# Public discovery catalog, separate from the private account/payment database.
# Create a separate Neon database (or run pnpm discovery:local for local development).
DISCOVERY_DATABASE_URL=
# Server/worker only. OpenAI-compatible embeddings for semantic search.
# Put your OpenAI API key here, not OPENAI_API_KEY or NEXT_PUBLIC_*.
DISCOVERY_EMBEDDING_API_KEY=
# OpenAI: https://api.openai.com/v1/embeddings
DISCOVERY_EMBEDDING_ENDPOINT=
# OpenAI: text-embedding-3-small
DISCOVERY_EMBEDDING_MODEL=
# Global maximum paid query-embedding cache misses per minute; cache hits are free.
DISCOVERY_QUERY_EMBEDDINGS_PER_MINUTE=60
# Optional development-only keyword snapshot instead of a discovery database.
DISCOVERY_CATALOG_PATH=

# Native ENS catalog reconstruction. Use a block before the supported registries were created.
INDEXER_ROOTS=ens402.eth
INDEXER_FROM_BLOCK=11700000
INDEXER_POLL_SECONDS=60
# Optional reproducible finalized block. Leave blank for the current finalized head.
INDEXER_TO_BLOCK=
# Optional Envio event-journal source. RPC reconstruction works without it.
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_ADMIN_SECRET=
# Required only when running Envio with its default HyperSync source.
ENVIO_API_TOKEN=

# Shared provider setup. Public addresses; the Safe is a writer, not necessarily the payTo.
PROVIDER_LABEL=
PLATFORM_REGISTRAR_ADDRESS=
PROVIDER_ADMIN_ADDRESS=
PROVIDER_OPS_ADDRESS=
PROVIDER_TREASURY_ADMIN_ADDRESS=
# Populate from confirmed setup receipts, then configure all three bindings together.
PROVIDER_ENS_NAME=
PROVIDER_REGISTRY_ADDRESS=
PROVIDER_RESOLVER_ADDRESS=
PROVIDER_SERVICE_REGISTRAR_ADDRESS=
# Required public invocation metadata for ens:plan. POST merchants need request binding.
SERVICE_CALL_JSON='{"method":"GET","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"example":{}}'

# Public address analytics, separate from the private account/payment database.
# May share the public discovery database. Enabling this adds analytics to discovery:watch.
ANALYTICS_DATABASE_URL=
# Explicit Base Sepolia scan start block. Pre-listing receipts are excluded from provider totals.
ANALYTICS_FROM_BLOCK=
# Optional reviewed JSON file: {"version":"reviewed-v1","network":"eip155:84532","addresses":[]}
# No implicit facilitator allowlist. Unknown origins remain unclassified token receipts.
ANALYTICS_FACILITATORS_FILE=
# Optional dedicated read-only connection to this operator's ENS402 execution ledger.
# The analytics worker otherwise uses DATABASE_URL read-only. Public routes never use this connection.
ANALYTICS_LEDGER_DATABASE_URL=
# Optional additional hosted Guard trust groups; JSON array of verified public deployment pins.
# [{"providerName":"other.ens402.eth","providerRegistry":"0x...","resolver":"0x..."}]
PROVIDER_GROUPS_JSON=
# Explicit opt-in for known isolated service resolver governance handovers, never shared providers.
ENS_MANAGEMENT_RESOLVER_POLICY=
