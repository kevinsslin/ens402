FROM node:22-bookworm AS builder

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY indexer/src ./indexer/src
COPY scripts ./scripts

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=builder /app /app
# Secrets are injected by the host, never copied into the image.
# Run schema migrations separately before starting this read-only chain worker.
USER node
ENV NODE_ENV=production
CMD ["node_modules/.bin/tsx", "indexer/src/worker.ts"]
