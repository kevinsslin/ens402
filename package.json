{
  "name": "ens402",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "cli": "tsx scripts/cli/ens402.ts",
    "cli:build": "tsx scripts/build-cli.ts",
    "test:cli": "tsc -p tsconfig.cli.json --noEmit && vitest run scripts/cli/core.test.ts scripts/cli/direct.test.ts scripts/cli/direct-flow.test.ts scripts/cli/direct-resolve.test.ts",
    "dev": "pnpm --filter @ens402/web dev",
    "build": "pnpm --filter @ens402/web build",
    "typecheck": "pnpm --filter @ens402/sdk typecheck && pnpm --filter @ens402/server typecheck && pnpm --filter @ens402/web typecheck",
    "test": "vitest run packages/sdk/test packages/server/test/external-preparation.test.ts packages/server/test/config.test.ts packages/server/test/transport.test.ts packages/server/test/merchant-demo.test.ts packages/server/test/merchant-delivery.test.ts packages/server/test/merchant-settle-retry.test.ts packages/server/test/discovery.test.ts packages/server/test/resolver-config.test.ts scripts/ens/provider-config.test.ts",
    "test:intercepta:live": "tsx scripts/intercepta-live.ts",
    "test:privy:live": "tsx scripts/privy-live.ts",
    "test:contracts": "forge test --root contracts --no-storage-caching -vv",
    "test:ens:fork": "tsx scripts/ens-fork.ts",
    "test:database": "vitest run packages/server/test/store.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:integration": "vitest run packages/server/test/store.test.ts packages/server/test/workflow.test.ts",
    "setup:check": "tsx scripts/check-setup.ts",
    "ens:plan": "tsx scripts/ens-plan.ts",
    "db:local": "tsx scripts/db-local.ts",
    "test:anvil": "pnpm exec tsc -p tsconfig.anvil.json --noEmit && pnpm test:contracts && tsx scripts/ens-fork.ts && tsx scripts/current-ens-fork.ts --payments && pnpm test:integration",
    "test:ens:current": "tsx scripts/current-ens-fork.ts",
    "ens:namespace:plan": "forge build --root contracts --quiet && tsx scripts/namespace-plan.ts",
    "ens:permissions:check": "tsx scripts/ens-permissions-check.ts",
    "ens:provider:plan": "forge build --root contracts --quiet && tsx scripts/provider-plan.ts",
    "discovery:local": "tsx scripts/discovery-local.ts",
    "discovery:migrate": "tsx scripts/discovery-migrate.ts",
    "discovery:sync": "tsx scripts/discovery-sync.ts",
    "discovery:embed": "tsx scripts/discovery-embed.ts",
    "discovery:check": "tsx scripts/discovery-check.ts",
    "discovery:fixtures": "tsx scripts/discovery-fixtures.ts",
    "test:discovery:database": "vitest run packages/server/test/discovery-store.test.ts",
    "test:web": "vitest run apps/web/test",
    "discovery:export": "tsx indexer/src/export.ts",
    "discovery:refresh": "tsx indexer/src/worker.ts --once",
    "discovery:watch": "tsx indexer/src/worker.ts",
    "test:discovery:fork": "forge build --root contracts --quiet && tsx indexer/src/fork.ts",
    "test:indexer": "npm --prefix indexer run codegen && npm --prefix indexer run typecheck && npm --prefix indexer test",
    "discovery:fixture-plan": "tsx scripts/discovery-fixture-plan.ts",
    "analytics:migrate": "tsx scripts/analytics-migrate.ts",
    "analytics:sync": "tsx scripts/analytics-sync.ts",
    "test:analytics": "vitest run packages/server/test/analytics.test.ts indexer/src/analytics.test.ts indexer/src/analytics-anvil.test.ts",
    "ens:manage": "tsx scripts/ens/manage.ts",
    "recipient:proof": "tsx scripts/recipient-proof.ts",
    "test:ens:management": "tsx scripts/ens/management-fork.ts",
    "test:ens:recipient": "forge build --root contracts --quiet && tsx scripts/ens/recipient-fork.ts",
    "provider:artifact": "forge build --root contracts --quiet && tsx scripts/build-provider-web-artifact.ts",
    "test:discovery:refresh": "vitest run indexer/src/refresh.test.ts packages/server/test/discovery-store.test.ts apps/web/test/discovery-sync.test.ts"
  },
  "devDependencies": {
    "@privy-io/node": "0.35.0",
    "@types/node": "^22",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "dotenv": "^18.0.4",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.56.9",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
