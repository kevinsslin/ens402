{
  "name": "ens402",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @ens402/web dev",
    "build": "pnpm --filter @ens402/web build",
    "typecheck": "pnpm --filter @ens402/sdk typecheck && pnpm --filter @ens402/server typecheck && pnpm --filter @ens402/web typecheck",
    "test": "vitest run packages/sdk/test packages/server/test/config.test.ts packages/server/test/merchant-demo.test.ts",
    "test:intercepta:live": "tsx scripts/intercepta-live.ts",
    "test:privy:live": "tsx scripts/privy-live.ts",
    "test:contracts": "forge test --root contracts --no-storage-caching -vv",
    "test:ens:fork": "tsx scripts/ens-fork.ts",
    "test:database": "vitest run packages/server/test/store.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:integration": "vitest run packages/server/test/store.test.ts packages/server/test/workflow.test.ts",
    "setup:check": "tsx scripts/check-setup.ts",
    "ens:plan": "tsx scripts/ens-plan.ts",
    "db:local": "tsx scripts/db-local.ts",
    "test:anvil": "pnpm exec tsc -p tsconfig.anvil.json --noEmit && pnpm test:contracts && tsx scripts/ens-fork.ts && tsx scripts/current-ens-fork.ts --payments && pnpm test:integration",
    "test:ens:current": "tsx scripts/current-ens-fork.ts",
    "ens:namespace:plan": "forge build --root contracts --quiet && tsx scripts/namespace-plan.ts"
  },
  "devDependencies": {
    "@privy-io/node": "0.35.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "dotenv": "^18.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.56.9",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
